load("@rules_shell//shell:sh_test.bzl", "sh_test")

filegroup(
    name = "migrations",
    srcs = glob(["migrations/*.sql"]),
    visibility = ["//src:__pkg__"],
)

alias(
    name = "rq_tui_lib",
    actual = "//src:rq_tui_lib",
    visibility = ["//visibility:private"],
)

alias(
    name = "rq-tui",
    actual = "//src:rq-tui",
    visibility = ["//visibility:private"],
)

sh_test(
    name = "bootstrap_bazelisk_test",
    srcs = ["tests/bootstrap_bazelisk_test.sh"],
    data = ["bootstrap-bazelisk.sh"],
    visibility = ["//visibility:private"],
)

sh_test(
    name = "non_tty_cli_test",
    srcs = ["tests/non_tty_cli_test.sh"],
    data = [":rq-tui"],
    deps = ["@rules_shell//shell/runfiles"],
    visibility = ["//visibility:private"],
)

sh_test(
    name = "pty_smoke_test",
    srcs = ["tests/pty_smoke_test.sh"],
    data = [
        ":rq-tui",
        "tests/pty_smoke.py",
    ],
    deps = ["@rules_shell//shell/runfiles"],
    tags = ["local", "pty"],
    timeout = "short",
    visibility = ["//visibility:private"],
)

test_suite(
    name = "rq_tui_tests",
    tests = [
        ":bootstrap_bazelisk_test",
        ":non_tty_cli_test",
        ":pty_smoke_test",
        "//src:clippy_test",
        "//src:rq_tui_tests",
        "//src:rustfmt_test",
    ],
    visibility = ["//visibility:private"],
)
