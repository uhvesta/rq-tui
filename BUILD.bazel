load("@rules_shell//shell:sh_test.bzl", "sh_test")

alias(
    name = "rq_tui_lib",
    actual = "//src:rq_tui_lib",
    visibility = ["//visibility:private"],
)

alias(
    name = "rq-tui",
    actual = "//src:rq-tui",
    visibility = ["//visibility:private"],
)

alias(
    name = "rev",
    actual = "//src:rev",
    visibility = ["//visibility:private"],
)

sh_test(
    name = "bootstrap_bazelisk_test",
    srcs = ["tests/bootstrap_bazelisk_test.sh"],
    data = ["bootstrap-bazelisk.sh"],
    visibility = ["//visibility:private"],
)

sh_test(
    name = "non_tty_cli_test",
    srcs = ["tests/non_tty_cli_test.sh"],
    data = [":rq-tui"],
    deps = ["@rules_shell//shell/runfiles"],
    visibility = ["//visibility:private"],
)

sh_test(
    name = "rev_non_tty_cli_test",
    srcs = ["tests/rev_non_tty_cli_test.sh"],
    data = [":rev"],
    deps = ["@rules_shell//shell/runfiles"],
    visibility = ["//visibility:private"],
)

sh_test(
    name = "pty_smoke_test",
    srcs = ["tests/pty_smoke_test.sh"],
    data = [
        ":rq-tui",
        "tests/pty_smoke.py",
    ],
    deps = ["@rules_shell//shell/runfiles"],
    tags = ["local", "pty"],
    timeout = "short",
    visibility = ["//visibility:private"],
)

sh_test(
    name = "rev_pty_smoke_test",
    srcs = ["tests/rev_pty_smoke_test.sh"],
    data = [
        ":rev",
        "tests/pty_smoke.py",
        "tests/rev_pty_smoke.py",
    ],
    deps = ["@rules_shell//shell/runfiles"],
    tags = ["local", "pty"],
    timeout = "short",
    visibility = ["//visibility:private"],
)

test_suite(
    name = "rq_tui_tests",
    tests = [
        "//crates/app:app_test_suite",
        "//crates/storage:storage_test_suite",
        "//crates/tui_text:tui_text_test_suite",
        ":bootstrap_bazelisk_test",
        ":non_tty_cli_test",
        ":rev_non_tty_cli_test",
        ":rev_pty_smoke_test",
        ":pty_smoke_test",
        "//src:clippy_test",
        "//src:rq_tui_tests",
        "//src:rustfmt_test",
    ],
    visibility = ["//visibility:private"],
)
