load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy_test",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)
load("@crates//:defs.bzl", "crate_deps")

RUNTIME_DEPS = crate_deps([
    "anyhow",
    "base64",
    "chrono",
    "clap",
    "crossterm",
    "dirs",
    "github-copilot-sdk",
    "ratatui",
    "serde",
    "serde_json",
    "sha2",
    "signal-hook",
    "similar",
    "tempfile",
    "tokio",
    "uuid",
    "walkdir",
], package_name = "")

PROC_MACRO_DEPS = crate_deps(["async-trait"], package_name = "")

LIB_SRCS = glob(
    ["**/*.rs"],
    exclude = [
        "main.rs",
        "markdown_preview_fixture.rs",
        "rev_main.rs",
    ],
)

rust_library(
    name = "rq_tui_lib",
    srcs = LIB_SRCS,
    compile_data = ["//vendor/markdown-preview.nvim:assets"],
    crate_name = "rq_tui",
    crate_root = "lib.rs",
    edition = "2021",
    deps = RUNTIME_DEPS + [
        "//crates/app:app_lib",
        "//crates/domain:domain_lib",
        "//crates/github_review:github_review_lib",
        "//crates/storage:storage_lib",
        "//crates/tui_text:tui_text_lib",
    ],
    proc_macro_deps = PROC_MACRO_DEPS,
    visibility = [
        "//:__pkg__",
        "//src:__pkg__",
    ],
)

rust_binary(
    name = "rq-tui",
    srcs = ["main.rs"],
    edition = "2021",
    deps = [":rq_tui_lib"],
    visibility = ["//:__pkg__"],
)

rust_binary(
    name = "rev",
    srcs = ["rev_main.rs"],
    edition = "2021",
    deps = [":rq_tui_lib"],
    visibility = ["//:__pkg__"],
)

rust_binary(
    name = "markdown_preview_fixture",
    srcs = [
        "markdown_preview.rs",
        "markdown_preview_fixture.rs",
    ],
    compile_data = ["//vendor/markdown-preview.nvim:assets"],
    crate_root = "markdown_preview_fixture.rs",
    edition = "2021",
    testonly = True,
    deps = crate_deps([
        "anyhow",
        "serde_json",
        "uuid",
    ], package_name = ""),
)

rust_test(
    name = "rq_tui_tests",
    srcs = LIB_SRCS,
    compile_data = ["//vendor/markdown-preview.nvim:assets"],
    crate_root = "lib.rs",
    edition = "2021",
    deps = RUNTIME_DEPS + [
        "//crates/app:app_lib",
        "//crates/domain:domain_lib",
        "//crates/github_review:github_review_lib",
        "//crates/storage:storage_lib",
        "//crates/tui_text:tui_text_lib",
    ] + crate_deps(["pretty_assertions"], package_name = ""),
    proc_macro_deps = PROC_MACRO_DEPS,
    visibility = ["//:__pkg__"],
)

rust_clippy_test(
    name = "clippy_test",
    targets = [
        ":rq-tui",
        ":rev",
        ":rq_tui_lib",
        ":rq_tui_tests",
    ],
    visibility = ["//:__pkg__"],
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":rq-tui",
        ":rev",
        ":rq_tui_lib",
        ":rq_tui_tests",
    ],
    visibility = ["//:__pkg__"],
)
