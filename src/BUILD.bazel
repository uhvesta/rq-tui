load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy_test",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)
load("@crates//:defs.bzl", "crate_deps")

RUNTIME_DEPS = crate_deps([
    "anyhow",
    "base64",
    "chrono",
    "clap",
    "crossterm",
    "dirs",
    "github-copilot-sdk",
    "lru",
    "ratatui",
    "rusqlite",
    "serde",
    "serde_json",
    "sha2",
    "similar",
    "syntect",
    "tempfile",
    "tokio",
    "two-face",
    "unicode-segmentation",
    "unicode-width",
    "uuid",
    "walkdir",
], package_name = "")

PROC_MACRO_DEPS = crate_deps(["async-trait"], package_name = "")

LIB_SRCS = glob(["**/*.rs"], exclude = ["main.rs"])

rust_library(
    name = "rq_tui_lib",
    srcs = LIB_SRCS,
    compile_data = ["//:migrations"],
    crate_name = "rq_tui",
    crate_root = "lib.rs",
    edition = "2021",
    deps = RUNTIME_DEPS + ["//crates/app:app_lib", "//crates/domain:domain_lib"],
    proc_macro_deps = PROC_MACRO_DEPS,
    visibility = [
        "//:__pkg__",
        "//src:__pkg__",
    ],
)

rust_binary(
    name = "rq-tui",
    srcs = ["main.rs"],
    edition = "2021",
    deps = [":rq_tui_lib"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "rq_tui_tests",
    srcs = LIB_SRCS,
    compile_data = ["//:migrations"],
    crate_root = "lib.rs",
    edition = "2021",
    deps = RUNTIME_DEPS + ["//crates/app:app_lib", "//crates/domain:domain_lib"] + crate_deps(["pretty_assertions"], package_name = ""),
    proc_macro_deps = PROC_MACRO_DEPS,
    visibility = ["//:__pkg__"],
)

rust_clippy_test(
    name = "clippy_test",
    targets = [
        ":rq-tui",
        ":rq_tui_lib",
        ":rq_tui_tests",
    ],
    visibility = ["//:__pkg__"],
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":rq-tui",
        ":rq_tui_lib",
        ":rq_tui_tests",
    ],
    visibility = ["//:__pkg__"],
)
